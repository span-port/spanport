# Copy to .env and replace the placeholder values. Never commit .env.
# Used by docker-compose.yml and by the server when run outside Docker.
# Hosts are localhost for running the server or tests on your machine;
# docker-compose.yml overrides them with service names inside Docker.

# Server
TRACEPORT_LOG_LEVEL=INFO

# Postgres (config store)
TRACEPORT_POSTGRES_HOST=localhost
# Host port for Docker's Postgres; 5433 avoids clashing with a locally installed Postgres on 5432.
TRACEPORT_POSTGRES_PORT=5433
TRACEPORT_POSTGRES_USER=traceport
TRACEPORT_POSTGRES_PASSWORD=change-me
TRACEPORT_POSTGRES_DB=traceport

# ClickHouse (logs and telemetry store)
TRACEPORT_CLICKHOUSE_HOST=localhost
TRACEPORT_CLICKHOUSE_PORT=8123
TRACEPORT_CLICKHOUSE_USER=traceport
TRACEPORT_CLICKHOUSE_PASSWORD=change-me
TRACEPORT_CLICKHOUSE_DB=traceport
