# Copy to .env and replace the placeholder values. Never commit .env.
# Used by docker-compose.yml and by the server when run outside Docker.
# Hosts are localhost for running the server or tests on your machine;
# docker-compose.yml overrides them with service names inside Docker.

# Server
SPANPORT_LOG_LEVEL=INFO
SPANPORT_SERVER_HOST=127.0.0.1
SPANPORT_SERVER_PORT=8000
# true restarts the server on code changes (docker-compose.dev.yml sets it)
SPANPORT_SERVER_RELOAD=false

# Alert emails (optional). Without SMTP_HOST, alert rules can't be saved.
# Any SMTP server works, e.g. your provider's relay or Gmail (smtp.gmail.com) with an app password.
SPANPORT_SMTP_HOST=
# 587 starts plain and upgrades with STARTTLS; 465 is SSL from the start (both work).
SPANPORT_SMTP_PORT=587
SPANPORT_SMTP_USERNAME=
SPANPORT_SMTP_PASSWORD=
# The sender alert emails come from; required when SMTP_HOST is set.
SPANPORT_SMTP_FROM=alerts@example.com
# true upgrades the connection with STARTTLS (port 587); false for a local relay without TLS
SPANPORT_SMTP_STARTTLS=true
# Where people open the UI. Optional; used only for the buttons in alert emails
# ("Open alert", "See matching logs"). Leave empty for emails without buttons.
SPANPORT_UI_URL=http://localhost:8080

# Alert checking and limits (optional; these are the defaults)
# Seconds between checks of every rule (5 to 300). The Alerts page refreshes as often.
SPANPORT_ALERT_CHECK_SECONDS=10
# Most email addresses per rule (1 to 100)
SPANPORT_ALERT_MAX_EMAILS=10
# Longest window a rule may count over, in minutes (1 to 1440)
SPANPORT_ALERT_MAX_WINDOW_MINUTES=60
# Most alert rules per project (1 to 1000)
SPANPORT_ALERT_MAX_RULES_PER_PROJECT=50

# Sign-in rate limit per email (optional; these are the defaults): this many wrong passwords
# within the window lock that email until the oldest of them is older than the window.
SPANPORT_LOGIN_FAILURE_LIMIT=5
SPANPORT_LOGIN_FAILURE_WINDOW_MINUTES=15

# Web UI (Docker); in development, `npm run dev` in ui/ serves it on Vite's port 5173
SPANPORT_UI_PORT=8080

# OpenTelemetry Collector (where apps send telemetry)
SPANPORT_COLLECTOR_GRPC_PORT=4317
SPANPORT_COLLECTOR_HTTP_PORT=4318

# Postgres (config store)
SPANPORT_POSTGRES_HOST=localhost
# Host port for Docker's Postgres; 5433 avoids clashing with a locally installed Postgres on 5432.
SPANPORT_POSTGRES_PORT=5433
SPANPORT_POSTGRES_USER=spanport
SPANPORT_POSTGRES_PASSWORD=change-me
SPANPORT_POSTGRES_DB=spanport

# ClickHouse (logs and telemetry store)
SPANPORT_CLICKHOUSE_HOST=localhost
SPANPORT_CLICKHOUSE_PORT=8123
SPANPORT_CLICKHOUSE_USER=spanport
SPANPORT_CLICKHOUSE_PASSWORD=change-me
SPANPORT_CLICKHOUSE_DB=spanport
